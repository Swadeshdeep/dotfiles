{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 5,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": [
        "memory",
        "temperature",
        "custom/network",
        "wireplumber",
        "custom/mic_hw",
        "battery",
        "network",
        "bluetooth",
        "tray",
        "clock"
    ],

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": false,
        "sort-by-name": true,
        "ignore-hidden": true,
        "active-only": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "format-icons": {
            "urgent": "",
            "default": ""
        }
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by": "number",
        "active-only": false,
        "format-icons": {
            "urgent": "",
            "default": ""
        }
    },

    "hyprland/window": {
        "format": "{class} — {title}",
        "max-length": 60
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "wireplumber": {
        "format": "󰕾 {volume}%",
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "foot -a pw-top pw-top"
    },

    "custom/mic_hw": {
        "exec": "~/.config/waybar/mic_hw_status.sh",
        "interval": 1,
        "return-type": "text",
        "tooltip": false
    },

    "battery": {
        "bat": "BAT0",
        "interval": 30,
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 30
        },
        "tooltip-format": "{capacity}% — {timeTo} remaining"
    },

    "memory": {
        "interval": 30,
        "format": " {used:0.1f}G",
        "on-click": "missioncenter"
    },

    "custom/network": {
        "exec": "bash -c 'prev_rx=$(cat /sys/class/net/wlan0/statistics/rx_bytes); prev_tx=$(cat /sys/class/net/wlan0/statistics/tx_bytes); sleep 1; curr_rx=$(cat /sys/class/net/wlan0/statistics/rx_bytes); curr_tx=$(cat /sys/class/net/wlan0/statistics/tx_bytes); rx_speed=$((($curr_rx-$prev_rx)/1024)); tx_speed=$((($curr_tx-$prev_tx)/1024)); if [ $rx_speed -ge 1000 ]; then rx_speed=$(echo \"scale=1; $rx_speed/1024\" | bc); rx_unit=\"MB/s\"; else rx_unit=\"KB/s\"; fi; if [ $tx_speed -ge 1000 ]; then tx_speed=$(echo \"scale=1; $tx_speed/1024\" | bc); tx_unit=\"MB/s\"; else tx_unit=\"KB/s\"; fi; echo \"{\\\"text\\\": \\\" ${rx_speed}${rx_unit}  ${tx_speed}${tx_unit}\\\", \\\"tooltip\\\": \\\"Download: ${rx_speed}${rx_unit}\\nUpload: ${tx_speed}${tx_unit}\\\"}\"'",
        "interval": 1,
        "return-type": "json"
    },

    "temperature": {
        "format": " {temperatureC}°C",
        "on-click": "ghostty -e btop"
    },

    "network": {
        "format": "",
        "format-ethernet": "󰌷",
        "format-wifi": "{icon}",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    }
}
